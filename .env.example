# AI Agent Configuration (IDE chat panel)
# Add your API keys below. At least one is required for the AI agent to work.
# The agent auto-selects a provider from whichever key is present, preferring
# Groq (free tier). The panel's provider dropdown just overrides that choice —
# selecting a provider whose key is missing safely falls back to an available one.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Groq (free, fast LLM inference) — powers BOTH Build Mode and, by default, the
# IDE coding agent. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional agent model overrides per provider (defaults shown). The agent uses
# groq:llama-3.3-70b-versatile by default when only a Groq key is present.
# AGENT_MODEL_GROQ=groq:llama-3.3-70b-versatile   # free-tier tool-capable model.
# It occasionally emits a malformed tool call (Groq rejects it); the agent retries
# the turn on a fresh key automatically. Tune retries with AGENT_TOOLCALL_RETRIES
# (default 2). If your account has it, groq:meta-llama/llama-4-scout-17b-16e-instruct
# is steadier at tool calls.
# AGENT_MODEL_ANTHROPIC=anthropic:claude-sonnet-4-5
# AGENT_MODEL_OPENAI=openai:gpt-4.1
# AGENT_MODEL_GEMINI=google:gemini-2.0-flash
# GITCLAW_MODEL=   # force one model for the agent (ignored if its provider has no key)

# Max tokens the agent may generate PER reply. Groq's 12k tokens-per-minute free
# tier counts input + reserved output, and the agent stack otherwise reserves the
# model's full 32k output window — which alone exceeds 12k and causes a 413
# ("Requested 33889"). Capping keeps a whole turn under the limit. Raise this on a
# paid Groq tier for longer replies. Default 3000.
# AGENT_MAX_OUTPUT_TOKENS=3000

# Optional: add extra Groq keys from OTHER organizations to raise total
# throughput. BOTH Build Mode AND the IDE agent round-robin across every key
# (GROQ_API_KEY + GROQ_API_KEY_2..10, plus any GROQ_API_KEYS list — all merged &
# de-duplicated), staying under each org's tokens-per-minute (TPM) limit. This
# raises how many tokens/minute you can push across requests; it does NOT raise
# the per-request size cap, so one oversized prompt still can't exceed one org's
# limit (that's handled separately by trimming large injected docs).
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
# GROQ_API_KEYS=key_org1,key_org2,key_org3

# The knowledge builder gets a key TO ITSELF, taken out of the chat pool.
# It runs once when a workspace opens and reads ~24k characters of the repo to
# write knowledge/overview.md — four times what a chat turn can afford. Sharing a
# key would spend the user's first minute of typing, and Groq's limit is per
# ORGANISATION, so rotating does not help: it is the same bucket being drained.
#
# Left unset, the LAST configured key is reserved automatically (so with six keys
# above, chat gets five and the builder gets one). Set this to choose a specific
# key, or one from a different provider entirely.
# GROQ_KNOWLEDGE_API_KEY=
#
# KNOWLEDGE_INPUT_CHARS=24000        how much of the repo the builder reads
# KNOWLEDGE_MAX_OUTPUT_TOKENS=2500   how long the document may be
# KNOWLEDGE_RETRIES=2                llama-3.3 drops sections; each retry names the gap

# Optional tuning (sensible defaults shown):
#   GROQ_TPM            per-key tokens-per-minute limit           (default 12000)
#   GROQ_TPM_HEADROOM   fraction of TPM we actually use, 0-1      (default 0.85)
#   GROQ_GEN_MAX_TOKENS output cap per generation chunk           (default 6000)
# GROQ_TPM=12000
# GROQ_TPM_HEADROOM=0.85
# GROQ_GEN_MAX_TOKENS=6000
