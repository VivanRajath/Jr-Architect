# AI Agent Configuration (IDE chat panel)
# Add your API keys below. At least one is required for the AI agent to work.
# The agent auto-selects a provider from whichever key is present, preferring
# Groq (free tier). The panel's provider dropdown just overrides that choice —
# selecting a provider whose key is missing safely falls back to an available one.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Groq (free, fast LLM inference) — powers BOTH Build Mode and, by default, the
# IDE coding agent. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional agent model overrides per provider (defaults shown). The agent uses
# groq:openai/gpt-oss-120b by default when only a Groq key is present (the older
# llama-3.x models were decommissioned by Groq).
# AGENT_MODEL_GROQ=groq:openai/gpt-oss-120b   # free-tier tool-capable model.
# If a turn ever comes back with a tool call Groq rejects, the agent retries it on
# a fresh key automatically. Tune retries with AGENT_TOOLCALL_RETRIES (default 2).
# groq:openai/gpt-oss-20b is the cheaper, weaker sibling if you are TPM-bound.
# AGENT_MODEL_ANTHROPIC=anthropic:claude-sonnet-4-5
# AGENT_MODEL_OPENAI=openai:gpt-4.1
# AGENT_MODEL_GEMINI=google:gemini-2.0-flash
# GITCLAW_MODEL=   # force one model for the agent (ignored if its provider has no key)

# Max tokens the agent may generate PER reply. Groq's 12k tokens-per-minute free
# tier counts input + reserved output, and the agent stack otherwise reserves the
# model's full 32k output window — which alone exceeds 12k and causes a 413
# ("Requested 33889"). Capping keeps a whole turn under the limit. Raise this on a
# paid Groq tier for longer replies. Default 3000.
# AGENT_MAX_OUTPUT_TOKENS=3000

# Optional: add extra Groq keys from OTHER organizations to raise total
# throughput. BOTH Build Mode AND the IDE agent round-robin across every key
# (GROQ_API_KEY + GROQ_API_KEY_2..10, plus any GROQ_API_KEYS list — all merged &
# de-duplicated), staying under each org's tokens-per-minute (TPM) limit. This
# raises how many tokens/minute you can push across requests; it does NOT raise
# the per-request size cap, so one oversized prompt still can't exceed one org's
# limit (that's handled separately by trimming large injected docs).
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
# GROQ_API_KEYS=key_org1,key_org2,key_org3

# The knowledge builder gets a key TO ITSELF, taken out of the chat pool.
# It runs once when a workspace opens and reads ~24k characters of the repo to
# write knowledge/overview.md — four times what a chat turn can afford. Sharing a
# key would spend the user's first minute of typing, and Groq's limit is per
# ORGANISATION, so rotating does not help: it is the same bucket being drained.
#
# Left unset, the LAST configured key is reserved automatically (so with six keys
# above, chat gets five and the builder gets one). Set this to choose a specific
# key, or one from a different provider entirely.
# GROQ_KNOWLEDGE_API_KEY=
#
# KNOWLEDGE_INPUT_CHARS=24000        how much of the repo the builder reads
# KNOWLEDGE_MAX_OUTPUT_TOKENS=2500   how long the document may be
# KNOWLEDGE_RETRIES=2                the model drops sections; each retry names the gap

# Optional tuning (sensible defaults shown):
#   GROQ_TPM            per-key tokens-per-minute limit           (default 12000)
#   GROQ_TPM_HEADROOM   fraction of TPM we actually use, 0-1      (default 0.85)
#   GROQ_GEN_MAX_TOKENS output cap per generation chunk           (default 6000)
# GROQ_TPM=12000
# GROQ_TPM_HEADROOM=0.85
# GROQ_GEN_MAX_TOKENS=6000

# ── Public beta (leave all of these unset for local development) ──────────────
# Setting JR_PUBLIC_ORIGIN turns on public mode, which refuses to start unless a login
# (JR_BETA_CODE and/or an OAuth app below), JR_SESSION_SECRET and JR_PREVIEW_DOMAIN are set too.
# JR_PUBLIC_ORIGIN=https://jrarch.duckdns.org
# Previews are served at p-<random token>.<JR_PREVIEW_DOMAIN>; needs wildcard DNS.
# Locally, JR_PREVIEW_DOMAIN=localhost tries host routing on p-<token>.localhost:9000.
# JR_PREVIEW_DOMAIN=jrarch.duckdns.org
# JR_BETA_CODE=the-shared-code-you-give-testers

# ── Sign in with Google / GitHub (either one turns the login on) ──────────────
# Callback URLs to register: <origin>/auth/oauth/google/callback and <origin>/auth/oauth/github/callback,
# where <origin> is JR_PUBLIC_ORIGIN, or http://localhost:9000 when running locally.
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application).
# JR_GOOGLE_CLIENT_ID=
# JR_GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers > New OAuth App. Signing in with GitHub also connects the
# user's repositories; Google users can connect GitHub later from Settings or the IDE.
# JR_GITHUB_CLIENT_ID=
# JR_GITHUB_CLIENT_SECRET=
# A GitHub account you control, invited (push access) to every repo Jr Architect creates for a user.
# Register the account first: if the name is unclaimed, whoever registers it later would get those invites.
# JR_GITHUB_COLLABORATOR=jr-architect
# That account's own token (classic, scope: repo), so it accepts invitations to repos this server published.
# Invitations to any other repo are ignored. The token is checked against the account name at startup.
# JR_GITHUB_COLLABORATOR_TOKEN=
# Optional allow-list for OAuth sign-in: emails, @domains or gh:<login>, comma-separated. Empty lets anyone in.
# JR_OAUTH_ALLOW=you@example.com,@yourcompany.com,gh:octocat
# At least 32 characters; e.g. `openssl rand -hex 32`. Changing it signs everyone out.
# JR_SESSION_SECRET=
# Only when the agent runs as its own service (JR_SPAWN_AGENT=0): both sides must share it.
# JR_INTERNAL_TOKEN=
# JR_SPAWN_AGENT=1
# JR_LISTEN_ADDR=127.0.0.1:9000
# Sandbox workdirs live here; startup deletes any sandbox-*/builder-* left inside.
# JR_WORK_DIR=/var/lib/jrarch/work
# Saved projects and keys pasted in Settings (default ~/.jr-architect).
# JR_DATA_DIR=/var/lib/jrarch/data
# MongoDB (e.g. a free Atlas cluster). When set, users, sign-in identities, projects, saved keys, agents,
# workflows, runs, memory, API keys and playground chats live there; existing files are imported once.
# Give each server its own database name: GitHub tokens and keys are encrypted with that server's JR_SESSION_SECRET.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=jr_architect
# JR_MAX_SANDBOXES=6          running at once, across everyone (0 = no cap)
# JR_MAX_PER_USER=1           default 1 once JR_BETA_CODE is set, otherwise no cap
# JR_SANDBOX_IDLE_TTL=15m     no owner activity for this long and a running sandbox is removed
# JR_SANDBOX_MAX_TTL=45m      removed at this age however active it is
# JR_LLM_PER_HOUR=60          model calls per user per hour (default 60 in public mode, 0 = no cap)
# Container engine: docker (default) or podman. With rootless podman, also point the
# Docker SDK (terminal, /health) at podman's socket:
#   systemctl --user enable --now podman.socket
#   DOCKER_HOST=unix:///run/user/<uid>/podman/podman.sock
# JR_CONTAINER_CLI=podman
# Images to build at startup (default: all). The rest build the first time a repo needs one.
# JR_PREHEAT_IMAGES=node,react,python,builder
# New sandboxes are refused below this much free disk in JR_WORK_DIR (default 5120 in public mode).
# JR_MIN_FREE_DISK_MB=5120
# No domain? Give every preview its own free Cloudflare quick tunnel (no account needed).
# Needs the cloudflared binary; the IDE itself is exposed separately (e.g. Tailscale Funnel).
# JR_PREVIEW_MODE=quicktunnel
# JR_CLOUDFLARED=/usr/local/bin/cloudflared
# A sandbox whose workdir grows past this is reaped (default 3072 in public mode, 0 = no limit).
# JR_SANDBOX_MAX_DISK_MB=3072
